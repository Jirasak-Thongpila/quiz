# รหัสผ่านสำหรับเข้าหน้าจัดการอาจารย์ (/admin)
ADMIN_SECRET_KEY=admin1234

# Neon PostgreSQL Database URL (ตัวเลือก: หากใส่ค่านี้ ระบบจะสลับไปบันทึกลง Neon Cloud โดยอัตโนมัติ)
# ได้จาก https://console.neon.tech -> Connection Details -> Connection string
# รูปแบบ: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require
